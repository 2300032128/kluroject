# EduAgent AI Backend Configuration
PROJECT_NAME="EduAgent AI"
API_V1_STR="/api"
PORT=8000

# Demo Mode Configuration (true = runs offline with mock fallback)
DEMO_MODE=true

# Database Configuration (Supports PostgreSQL or SQLite)
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/eduagent_db
# SQLite Example: sqlite:///./eduagent.db
DATABASE_URL="sqlite:///./eduagent.db"

# LLM Configuration (Server-Side Only - Never expose to frontend!)
GEMINI_API_KEY=""
